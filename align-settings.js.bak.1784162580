356|  /* ════════════════════════════════════════════════════════════════════════════
357|   * RENDER
358|   * ════════════════════════════════════════════════════════════════════════════ */
359|
360|  var ui = {
361|    container: null,
362|    /* PIN change state */
363|    pinDialogOpen: false,
364|    pinError: ''
365|  };
366|
367|  function render(container) {
368|    if (!container) return;
369|    ui.container = container;
370|    ui.pinDialogOpen = false;
371|    ui.pinError = '';
372|    injectCSS();
373|    _paint();
374|    _wire();
375|  }
376|
377|  function _paint() {
378|    var c = ui.container;
379|    if (!c) return;
380|
381|    var auth  = global.AlignAuth;
382|    var user  = auth ? auth.getActiveUser() : null;
383|
384|    // ── Build HTML ──────────────────────────────────────────────────────────
385|    var parts = ['<div class="st-settings">'];
386|
387|    /* 1. USER PROFILE */
388|    parts.push(_userProfileHTML(user));
389|
390|    /* 2. APPEARANCE */
391|    parts.push(_appearanceHTML());
392|
393|    /* 3. DATA */
394|    parts.push(_dataHTML());
395|
396|    /* 4. ABOUT */
397|    parts.push(_aboutHTML());
398|
399|    parts.push('</div>'); // .st-settings
400|
401|    c.innerHTML = parts.join('');
402|  }
403|
404|  /* ── 1. User Profile ──────────────────────────────────────────────────── */
405|  function _userProfileHTML(user) {
406|    var html = ['<div class="st-section">'];
407|
408|    html.push(
409|      '<div class="st-section-header">',
410|        '<div class="st-section-icon" style="background:var(--brand-bg);color:var(--brand);">👤</div>',
411|        '<span class="st-section-title">Your Profile</span>',
412|      '</div>'
413|    );
414|
415|    if (!user) {
416|      html.push(
417|        '<div class="pm-empty">',
418|          '<strong>Not signed in</strong>',
419|          'Sign in to see your profile.',
420|        '</div>'
421|      );
422|    } else {
423|      var displayName = user.name || (user.firstName + ' ' + user.lastName);
424|      var initials = (displayName || '??').split(' ').map(function(p) { return (p || '')[0] || ''; }).join('').toUpperCase().slice(0, 2) || '?';
425|      html.push(
426|        '<div class="st-profile-card">',
427|          '<div class="st-profile-avatar">', esc(initials), '</div>',
428|          '<div class="st-profile-info">',
429|            '<div class="st-profile-name">', esc(displayName), '</div>',
430|            '<div class="st-profile-email">', esc(user.email || ''), '</div>',
431|            '<span class="st-role-badge ', user.role === 'admin' ? 'admin' : 'user', '">', esc(user.role), '</span>',
432|          '</div>',
433|          '<div class="st-profile-actions">',
434|            '<button class="pm-btn small" data-st-act="change-pin">🔐 Change Password</button>',
435|            '<button class="pm-btn small" data-st-act="refresh-cache">🔄 Refresh Cache</button>',
436|            '<button class="pm-btn small danger" data-st-act="sign-out">Sign Out</button>',
437|          '</div>',
438|        '</div>'
439|      );
440|    }
441|
442|    html.push('</div>');
443|    return html.join('');
444|  }
445|
446|  /* ── 2. Appearance ──────────────────────────────────────────────────────── */
447|  function _appearanceHTML() {
448|    var theme    = getTheme();
449|    var tileSize = getTileSize();
450|    var tempUnit = getTempUnit();
451|
452|    var themeButtons = ['system', 'light', 'dark'].map(function (t) {
453|      var active = t === theme ? ' st-seg-active' : '';
454|      return '<button data-st-act="set-theme" data-st-val="' + t + '" class="' + active + '">' +
455|        t.charAt(0).toUpperCase() + t.slice(1) + '</button>';
456|    }).join('');
457|
458|    var tileButtons = ['compact', 'default', 'large'].map(function (t) {
459|      var active = t === tileSize ? ' st-seg-active' : '';
460|      return '<button data-st-act="set-tile-size" data-st-val="' + t + '" class="' + active + '">' +
461|        t.charAt(0).toUpperCase() + t.slice(1) + '</button>';
462|    }).join('');
463|
464|    var tempUnitButtons = ['F', 'C'].map(function (t) {
465|      var active = t === tempUnit ? ' st-seg-active' : '';
466|      return '<button data-st-act="set-tempunit" data-st-val="' + t + '" class="' + active + '">°' + t + '</button>';
467|    }).join('');
468|
469|    return [
470|      '<div class="st-section">',
471|        '<div class="st-section-header">',
472|          '<div class="st-section-icon" style="background:rgba(245,158,11,0.1);color:#f59e0b;">🎨</div>',
473|          '<span class="st-section-title">Appearance</span>',
474|        '</div>',
475|        '<div class="st-setting-row">',
476|          '<div>',
477|            '<div class="st-setting-label">Theme</div>',
478|            '<div class="st-setting-hint">Choose light, dark, or follow your system</div>',
479|          '</div>',
480|          '<div class="st-segmented">', themeButtons, '</div>',
481|        '</div>',
482|        '<div class="st-setting-row">',
483|          '<div>',
484|            '<div class="st-setting-label">Tile Size</div>',
485|            '<div class="st-setting-hint">Adjust the dashboard tile size</div>',
486|          '</div>',
487|          '<div class="st-segmented">', tileButtons, '</div>',
488|        '</div>',
489|        '<div class="st-setting-row">',
490|          '<div>',
491|            '<div class="st-setting-label">Temperature</div>',
492|            '<div class="st-setting-hint">Fahrenheit or Celsius</div>',
493|          '</div>',
494|          '<div class="st-segmented">', tempUnitButtons, '</div>',
495|        '</div>',
496|      '</div>'
497|    ].join('');
498|  }
499|
516|  /* ── 3. Data ────────────────────────────────────────────────────────────── */
517|  function _dataHTML() {
518|    var isOwner = _isOwner();
519|    return [
520|      '<div class="st-section">',
521|        '<div class="st-section-header">',
522|          '<div class="st-section-icon" style="background:rgba(16,185,129,0.1);color:#10b981;">💾</div>',
523|          '<span class="st-section-title">Data</span>',
524|        '</div>',
525|        isOwner ? '<div class="st-setting-row">' +
526|          '<div>' +
527|            '<div class="st-setting-label">Export Project Data</div>' +
528|            '<div class="st-setting-hint">Download all records for the current project as JSON</div>' +
529|          '</div>' +
530|          '<button class="pm-btn small" data-st-act="export-data">Export JSON</button>' +
531|        '</div>' +
532|        '<div class="st-danger-zone">' +
533|          '<div>' +
534|            '<div class="st-danger-zone-label">Clear Project Data</div>' +
535|            '<div style="font-size:0.78rem;color:var(--muted);margin-top:2px;">Permanently delete all records for the current project</div>' +
536|          '</div>' +
537|          '<button class="pm-btn small danger" data-st-act="clear-data">Clear All Data</button>' +
538|        '</div>'
539|        : '<div class="st-setting-row">' +
540|          '<div class="st-setting-label" style="color:var(--muted);">Data export and clearing</div>' +
541|          '<div class="st-setting-hint">Only the account owner can export or clear project data</div>' +
542|        '</div>',
543|      '</div>'
544|    ].join('');
545|  }
546|
547|  /* ── 4. About ───────────────────────────────────────────────────────────── */
548|  function _aboutHTML() {
549|    return [
550|      '<div class="st-section">',
551|        '<div class="st-section-header">',
552|          '<div class="st-section-icon" style="background:rgba(107,114,128,0.1);color:#6b7280;">ℹ️</div>',
553|          '<span class="st-section-title">About</span>',
554|        '</div>',
555|        '<div class="st-about">',
556|          '<div class="st-about-version">Align v1.0</div>',
557|          '<div>Build date: June 2025</div>',
558|        '</div>',
559|      '</div>'
560|    ].join('');
561|  }
562|
563|  /* ════════════════════════════════════════════════════════════════════════════
564|   * WIRING — event delegation on the container
565|   * ════════════════════════════════════════════════════════════════════════════ */
566|
567|  function _wire() {
568|    var c = ui.container;
569|    if (!c) return;
570|
571|    // Remove old listener before adding — prevents stacking on re-renders
572|    c.removeEventListener('click', _onClick);
573|    c.addEventListener('click', _onClick);
574|  }
575|
576|  function _onClick(e) {
577|    var target = e.target;
578|    // Walk up to find the [data-st-act] button or link
579|    var el = target.closest('[data-st-act]');
580|    if (!el) return;
581|
582|    var act = el.getAttribute('data-st-act');
583|    var val = el.getAttribute('data-st-val');
584|
585|    switch (act) {
586|
587|      /* ── Sign Out ─────────────────────────────────────────────────────── */
588|      case 'sign-out':
589|        e.preventDefault();
590|        if (global.AlignAuth) {
591|          global.AlignAuth.signOut();
592|          // Refresh to show sign-in screen
593|          _paint();
594|          _wire();
595|        }
596|        break;
597|
598|      /* ── Refresh Cache ────────────────────────────────────────────────── */
599|      case 'refresh-cache':
600|        e.preventDefault();
601|        if ('caches' in window) {
602|          caches.keys().then(function(names) {
603|            for (var i = 0; i < names.length; i++) caches.delete(names[i]);
604|          }).then(function() {
605|            // Also unregister service workers
606|            if ('serviceWorker' in navigator && navigator.serviceWorker.getRegistrations) {
607|              navigator.serviceWorker.getRegistrations().then(function(regs) {
608|                for (var r = 0; r < regs.length; r++) regs[r].unregister();
609|                window.location.reload(true);
610|              });
611|            } else {
612|              window.location.reload(true);
613|            }
614|          });
615|        } else {
616|          window.location.reload(true);
617|        }
618|        break;
619|
620|      /* ── Sign Out Everywhere ──────────────────────────────────────────── */
621|      case 'sign-out-all':
622|        e.preventDefault();
623|        if (global.AlignAuth && global.AlignAuth.signOutAll) {
624|          global.AlignAuth.signOutAll();
625|          // Refresh to show sign-in screen
626|          _paint();
627|          _wire();
628|        } else if (global.AlignAuth) {
629|          // Fallback: just sign out locally
630|          global.AlignAuth.signOut();
631|          _paint();
632|          _wire();
633|        }
634|        break;
635|
636|      /* ── Change PIN ───────────────────────────────────────────────────── */
637|      case 'change-pin':
638|        e.preventDefault();
639|        _openPinDialog();
640|        break;
641|
642|      /* ── Theme ────────────────────────────────────────────────────────── */
643|      case 'set-theme':
644|        e.preventDefault();
645|        if (val) {
646|          setTheme(val);
647|          window._invalidateTileCache('settings');
648|          _paint();
649|          _wire();
650|        }
651|        break;
652|
653|      /* ── Tile Size ────────────────────────────────────────────────────── */
654|      case 'set-tile-size':
655|        e.preventDefault();
656|        if (val) {
657|          setTileSize(val);
658|          _refreshTileGrid(val);
659|          window._invalidateTileCache('settings');
660|          _paint();
661|          _wire();
662|        }
663|        break;
664|
665|      /* ── Temperature Unit ──────────────────────────────────────────────── */
666|      case 'set-tempunit':
667|        e.preventDefault();
668|        if (val) {
669|          setTempUnit(val);
670|          window._invalidateTileCache('settings');
671|          // Re-render weather instantly from cached data with new unit
672|          try { localStorage.removeItem('align_weather_html_v2'); } catch(e) {}
673|          if (window.__weatherData) window._renderWeatherCards(window.__weatherData);
674|          _paint();
675|          _wire();
676|        }
677|        break;
678|
679|      /* ── Export Data ──────────────────────────────────────────────────── */
680|      case 'export-data':
681|        e.preventDefault();
682|        if (!_isOwner()) { alert('Only the account owner can export project data.'); return; }
683|        _exportData();
684|        break;
685|
686|      /* ── Clear Data ───────────────────────────────────────────────────── */
687|      case 'clear-data':
688|        e.preventDefault();
689|        if (!_isOwner()) { alert('Only the account owner can clear project data.'); return; }
690|        _clearData();
691|        break;
692|
693|      /* ── Projects ──────────────────────────────────────────────────── */
694|      case 'proj-add':
695|        e.preventDefault();
696|        _showProjectModal();
697|        break;
698|      case 'proj-edit':
699|        e.preventDefault();
700|        _showProjectModal(el.getAttribute('data-proj-id'));
701|        break;
702|      case 'proj-delete':
703|        e.preventDefault();
704|        _deleteProject(el.getAttribute('data-proj-id'), el.getAttribute('data-proj-name'));
705|        break;
706|      case 'proj-invites':
707|        e.preventDefault();
708|        _showInvitesModal(el.getAttribute('data-proj-id'), el.getAttribute('data-proj-name'));
709|        break;
710|    }
711|  }
712|
713|  /* ── Refresh tile grid when tile size changes ──────────────────────────── */
714|  function _refreshTileGrid(size) {
715|    var grid = document.querySelector('.tile-grid');
716|    if (!grid) return;
717|
718|    // Remove all size classes
719|    grid.classList.remove('tile-grid--compact', 'tile-grid--large');
720|
721|    if (size === 'compact') {
722|      grid.classList.add('tile-grid--compact');
723|    } else if (size === 'large') {
724|      grid.classList.add('tile-grid--large');
725|    }
726|    // 'default' — no extra class
727|  }
728|
729|  /* ── Owner check (restrict destructive data operations) ────────────────── */
730|  function _isOwner() {
731|    var auth = global.AlignAuth;
732|    if (!auth) return false;
733|    var user = auth.getActiveUser();
734|    if (!user) return false;
735|    return user.email === 'admin@align.local';
736|  }
