1|/* align-settings.js
2| * ─────────────────────────────────────────────────────────────────────────────
3| * Align — Settings Dashboard module.
4| *
5| * Renders the Settings panel (replaces the inline renderSettingsMenu() in
6| * script.js) with five sections: User Profile, Appearance, Project
7| * Management, Data, and About.
8| *
9| * STORAGE
10| *   All settings are app-wide (not per-project). Keys live directly under
11| *   localStorage:
12| *     align.settings.theme      → 'system' | 'light' | 'dark'
13| *     align.settings.tileSize   → 'compact' | 'default' | 'large'
14| *
15| * PUBLIC API  (window.AlignSettings)
16| *   .render(container)   → mount the full Settings dashboard
17| *   .CATEGORY            → 'settings' (for routing compatibility)
18| */
19|
20|(function (global) {
21|  'use strict';
22|
23|  function S() { return global.AlignStorage; }
24|
25|  /* ── Settings key ────────────────────────────────────────────────────────── */
26|  var THEME_KEY    = 'align.settings.theme';
27|  var TILESIZE_KEY = 'align.settings.tileSize';
28|  var TEMPUNIT_KEY = 'align.settings.tempUnit';
29|
30|  /* ── Read / write helpers ────────────────────────────────────────────────── */
31|  function lsGet(key) {
32|    try {
33|      var raw = global.localStorage.getItem(key);
34|      return raw ? JSON.parse(raw) : null;
35|    } catch (e) { return null; }
36|  }
37|
38|  function lsSet(key, value) {
39|    try {
40|      global.localStorage.setItem(key, JSON.stringify(value));
41|      return true;
42|    } catch (e) { return false; }
43|  }
44|
45|  function getTheme()       { return lsGet(THEME_KEY)    || 'system'; }
46|  function setTheme(v)      { lsSet(THEME_KEY, v); applyTheme(v); }
47|  function getTileSize()    { return lsGet(TILESIZE_KEY) || 'default'; }
48|  function setTileSize(v)   { lsSet(TILESIZE_KEY, v); }
49|  function getTempUnit()    { return lsGet(TEMPUNIT_KEY) || 'F'; }
50|  function setTempUnit(v)   { lsSet(TEMPUNIT_KEY, v); }
51|
52|  /* ── Escaping ────────────────────────────────────────────────────────────── */
53|  function esc(s) {
54|    return String(s == null ? '' : s)
55|      .replace(/&/g, '&amp;')
56|      .replace(/</g, '&lt;')
57|      .replace(/>/g, '&gt;')
58|      .replace(/"/g, '&quot;')
59|      .replace(/'/g, '&#39;');
60|  }
61|
62|  /* ── Theme application ──────────────────────────────────────────────────── */
63|  function applyTheme(theme) {
64|    var resolved = theme;
65|    if (theme === 'system') {
66|      try {
67|        resolved = global.matchMedia('(prefers-color-scheme: dark)').matches
68|          ? 'dark' : 'light';
69|      } catch (e) { resolved = 'light'; }
70|    }
71|    var el = document.documentElement;
72|    if (el) el.setAttribute('data-theme', resolved);
73|  }
74|
75|  /* ════════════════════════════════════════════════════════════════════════════
76|   * CSS — injected once as an inline <style> tag (st- namespace)
77|   * ════════════════════════════════════════════════════════════════════════════ */
78|  var _cssInjected = false;
79|
80|  function injectCSS() {
81|    if (_cssInjected) return;
82|    _cssInjected = true;
83|
84|    var style = document.createElement('style');
85|    style.textContent = [
86|      /* ── Dashboard container ──────────────────────────────────────────── */
87|      '.st-settings {',
88|      '  display: flex;',
89|      '  flex-direction: column;',
90|      '  gap: 28px;',
91|      '}',
92|
93|      /* ── Section ──────────────────────────────────────────────────────── */
94|      '.st-section {',
95|      '  display: flex;',
96|      '  flex-direction: column;',
97|      '  gap: 12px;',
98|      '}',
99|      '.st-section-header {',
100|      '  display: flex;',
101|      '  align-items: center;',
102|      '  gap: 10px;',
103|      '  padding-bottom: 8px;',
104|      '  border-bottom: 1px solid var(--line);',
105|      '}',
106|      '.st-section-icon {',
107|      '  width: 32px;',
108|      '  height: 32px;',
109|      '  border-radius: var(--radius-sm, 8px);',
110|      '  display: flex;',
111|      '  align-items: center;',
112|      '  justify-content: center;',
113|      '  font-size: 1rem;',
114|      '  flex-shrink: 0;',
115|      '}',
116|      '.st-section-title {',
117|      '  font-size: 0.95rem;',
118|      '  font-weight: 800;',
119|      '  color: var(--ink);',
120|      '  letter-spacing: -0.01em;',
121|      '  text-transform: uppercase;',
122|      '}',
123|
124|      /* ── User profile card ────────────────────────────────────────────── */
125|      '.st-profile-card {',
126|      '  background: var(--card);',
127|      '  border: 1px solid var(--line);',
128|      '  border-radius: var(--radius-lg, 16px);',
129|      '  padding: 20px;',
130|      '  display: flex;',
131|      '  align-items: center;',
132|      '  gap: 16px;',
133|      '  flex-wrap: wrap;',
134|      '}',
135|      '.st-profile-avatar {',
136|      '  width: 52px;',
137|      '  height: 52px;',
138|      '  border-radius: 50%;',
139|      '  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-light) 100%);',
140|      '  color: #fff;',
141|      '  display: flex;',
142|      '  align-items: center;',
143|      '  justify-content: center;',
144|      '  font-size: 1.15rem;',
145|      '  font-weight: 800;',
146|      '  flex-shrink: 0;',
147|      '  box-shadow: 0 2px 8px rgba(26,95,212,0.3);',
148|      '}',
149|      '.st-profile-info {',
150|      '  flex: 1;',
151|      '  min-width: 140px;',
152|      '}',
153|      '.st-profile-name {',
154|      '  font-size: 1.05rem;',
155|      '  font-weight: 800;',
156|      '  color: var(--ink);',
157|      '  letter-spacing: -0.01em;',
158|      '}',
159|      '.st-profile-email {',
160|      '  font-size: 0.82rem;',
161|      '  color: var(--muted);',
162|      '  margin-top: 2px;',
163|      '}',
164|      '.st-profile-actions {',
165|      '  display: flex;',
166|      '  gap: 8px;',
167|      '  align-items: center;',
168|      '  flex-wrap: wrap;',
169|      '}',
170|
171|      /* ── Role badge ───────────────────────────────────────────────────── */
172|      '.st-role-badge {',
173|      '  display: inline-block;',
174|      '  font-size: 0.68rem;',
175|      '  font-weight: 700;',
176|      '  text-transform: uppercase;',
177|      '  letter-spacing: 0.5px;',
178|      '  padding: 2px 10px;',
179|      '  border-radius: 20px;',
180|      '  margin-top: 4px;',
181|      '}',
182|      '.st-role-badge.admin {',
183|      '  background: var(--brand-bg, rgba(26,95,212,0.06));',
184|      '  color: var(--brand);',
185|      '}',
186|      '.st-role-badge.user {',
187|      '  background: var(--bg-alt, #e6ebf0);',
188|      '  color: var(--muted);',
189|      '}',
190|
191|      /* ── Setting row ──────────────────────────────────────────────────── */
192|      '.st-setting-row {',
193|      '  display: flex;',
194|      '  align-items: center;',
195|      '  justify-content: space-between;',
196|      '  gap: 12px;',
197|      '  padding: 14px 16px;',
198|      '  background: var(--card);',
199|      '  border: 1px solid var(--line);',
200|      '  border-radius: var(--radius-md, 12px);',
201|      '  flex-wrap: wrap;',
202|      '}',
203|      '.st-setting-label {',
204|      '  font-size: 0.9rem;',
205|      '  font-weight: 700;',
206|      '  color: var(--ink);',
207|      '  letter-spacing: -0.01em;',
208|      '}',
209|      '.st-setting-hint {',
210|      '  font-size: 0.74rem;',
211|      '  color: var(--muted);',
212|      '  margin-top: 1px;',
213|      '}',
214|
215|      /* ── Segmented control (theme, tile size) ──────────────────────────── */
216|      '.st-segmented {',
217|      '  display: flex;',
218|      '  gap: 0;',
219|      '  border: 1px solid var(--line);',
220|      '  border-radius: var(--radius-sm, 8px);',
221|      '  overflow: hidden;',
222|      '  flex-shrink: 0;',
223|      '}',
224|      '.st-segmented button {',
225|      '  padding: 7px 14px;',
226|      '  border: none;',
227|      '  border-right: 1px solid var(--line);',
228|      '  background: var(--card);',
229|      '  color: var(--muted);',
230|      '  font-size: 0.78rem;',
231|      '  font-weight: 600;',
232|      '  cursor: pointer;',
233|      '  font-family: var(--font);',
234|      '  transition: all 0.15s ease;',
235|      '  white-space: nowrap;',
236|      '}',
237|      '.st-segmented button:last-child {',
238|      '  border-right: none;',
239|      '}',
240|      '.st-segmented button:hover {',
241|      '  background: var(--bg-alt);',
242|      '  color: var(--ink);',
243|      '}',
244|      '.st-segmented button.st-seg-active {',
245|      '  background: var(--brand);',
246|      '  color: #fff;',
247|      '  box-shadow: inset 0 0 0 1px var(--brand);',
248|      '}',
249|
250|      /* ── About section ────────────────────────────────────────────────── */
251|      '.st-about {',
252|      '  text-align: center;',
253|      '  padding: 24px 16px;',
254|      '  color: var(--muted);',
255|      '  font-size: 0.82rem;',
256|      '}',
257|      '.st-about .st-about-version {',
258|      '  font-size: 0.95rem;',
259|      '  font-weight: 700;',
260|      '  color: var(--ink);',
261|      '  margin-bottom: 4px;',
262|      '}',
263|
264|      /* ── PIN change dialog overlay ────────────────────────────────────── */
265|      '.st-pin-overlay {',
266|      '  position: fixed;',
267|      '  inset: 0;',
268|      '  z-index: 300;',
269|      '  background: rgba(0,0,0,0.35);',
270|      '  display: flex;',
271|      '  align-items: center;',
272|      '  justify-content: center;',
273|      '  backdrop-filter: blur(4px);',
274|      '  -webkit-backdrop-filter: blur(4px);',
275|      '}',
276|      '.st-pin-dialog {',
277|      '  background: var(--card);',
278|      '  border-radius: var(--radius-xl, 20px);',
279|      '  padding: 28px 24px;',
280|      '  width: 100%;',
281|      '  max-width: 360px;',
282|      '  box-shadow: var(--shadow-xl);',
283|      '  display: flex;',
284|      '  flex-direction: column;',
285|      '  gap: 14px;',
286|      '}',
287|      '.st-pin-dialog h3 {',
288|      '  margin: 0;',
289|      '  font-size: 1.1rem;',
290|      '  font-weight: 800;',
291|      '  color: var(--ink);',
292|      '  letter-spacing: -0.01em;',
293|      '}',
294|      '.st-pin-input {',
295|      '  padding: 10px 14px;',
296|      '  border: 1px solid var(--line);',
297|      '  border-radius: var(--radius-sm, 8px);',
298|      '  font-size: 0.9rem;',
299|      '  font-family: var(--font);',
300|      '  text-align: center;',
301|      '  letter-spacing: 0.3em;',
302|      '  max-width: 160px;',
303|      '  align-self: center;',
304|      '}',
305|      '.st-pin-input:focus {',
306|      '  outline: none;',
307|      '  border-color: var(--brand);',
308|      '  box-shadow: 0 0 0 3px rgba(26,95,212,0.10);',
309|      '}',
310|      '.st-pin-input::placeholder {',
311|      '  letter-spacing: normal;',
312|      '}',
313|      '.st-pin-error {',
314|      '  font-size: 0.78rem;',
315|      '  color: var(--danger);',
316|      '  text-align: center;',
317|      '  font-weight: 600;',
318|      '}',
319|      '.st-pin-actions {',
320|      '  display: flex;',
321|      '  gap: 8px;',
322|      '  justify-content: flex-end;',
323|      '}',
324|
325|      /* ── Danger zone card ─────────────────────────────────────────────── */
326|      '.st-danger-zone {',
327|      '  background: var(--danger-bg, #fef2f2);',
328|      '  border: 1px solid var(--danger);',
329|      '  border-radius: var(--radius-md, 12px);',
330|      '  padding: 16px;',
331|      '  display: flex;',
332|      '  align-items: center;',
333|      '  justify-content: space-between;',
334|      '  gap: 12px;',
335|      '  flex-wrap: wrap;',
336|      '}',
337|      '.st-danger-zone-label {',
338|      '  font-size: 0.85rem;',
339|      '  font-weight: 700;',
340|      '  color: var(--danger);',
341|      '}',
342|
343|      /* ── Responsive ───────────────────────────────────────────────────── */
344|      '@media (max-width: 480px) {',
345|      '  .st-profile-card { flex-direction: column; text-align: center; }',
346|      '  .st-profile-actions { justify-content: center; width: 100%; }',
347|      '  .st-setting-row { flex-direction: column; align-items: flex-start; }',
348|      '  .st-danger-zone { flex-direction: column; align-items: flex-start; }',
349|      '}',
350|
351|      /* ── Responsive ───────────────────────────────────────────────────── */
352|    ].join('\n');
353|    document.head.appendChild(style);
354|  }
