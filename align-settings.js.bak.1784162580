739|
999|  /* ── Sub-view helper (uses navigation stack in script.js) ────────────── */
1000|  function _showSubView(title, renderFn) {
1001|    if (window._pushSettingsSubview) {
1002|      window._pushSettingsSubview(title, renderFn);
1003|    }
1004|  }
1005|
1006|  /* ── PIN Change Dialog ─────────────────────────────────────────────────── */
1007|  function _openPinDialog() {
1008|    var auth = global.AlignAuth;
1009|    var user = auth ? auth.getActiveUser() : null;
1010|    if (!user) return;
1011|
1012|    // Build overlay
1013|    var overlay = document.createElement('div');
1014|    overlay.className = 'st-pin-overlay';
1015|    overlay.id = 'st-pin-overlay';
1016|
1017|    overlay.innerHTML = [
1018|      '<div class="st-pin-dialog">',
1019|        '<h3>Change Password</h3>',
1020|        '<input class="st-pin-input" id="st-pin-current" type="password" placeholder="Current password" autocomplete="current-password">',
1021|        '<input class="st-pin-input" id="st-pin-new" type="password" placeholder="New password (min 8 chars)" minlength="8" autocomplete="new-password">',
1022|        '<input class="st-pin-input" id="st-pin-confirm" type="password" placeholder="Confirm new password" minlength="8" autocomplete="new-password">',
1023|        '<div class="st-pin-error" id="st-pin-error" style="display:none;"></div>',
1024|        '<div class="st-pin-actions">',
1025|          '<button class="pm-btn" id="st-pin-cancel">Cancel</button>',
1026|          '<button class="pm-btn primary" id="st-pin-save">Save</button>',
1027|        '</div>',
1028|      '</div>'
1029|    ].join('');
1030|
1031|    document.body.appendChild(overlay);
1032|
1033|    // Focus the first input
1034|    setTimeout(function () {
1035|      var inp = document.getElementById('st-pin-current');
1036|      if (inp) inp.focus();
1037|    }, 100);
1038|
1039|    // Close on backdrop click
1040|    overlay.addEventListener('click', function (ev) {
1041|      if (ev.target === overlay) _closePinDialog();
1042|    });
1043|
1044|    // Cancel button
1045|    var cancelBtn = document.getElementById('st-pin-cancel');
1046|    if (cancelBtn) cancelBtn.addEventListener('click', _closePinDialog);
1047|
1048|    // Save button
1049|    var saveBtn = document.getElementById('st-pin-save');
1050|    if (saveBtn) saveBtn.addEventListener('click', _savePin);
1051|
1052|    // Keyboard: Enter to save, Escape to cancel
1053|    overlay.addEventListener('keydown', function (ev) {
1054|      if (ev.key === 'Escape') {
1055|        _closePinDialog();
1056|      } else if (ev.key === 'Enter') {
1057|        _savePin();
1058|      }
1059|    });
1060|  }
1061|
1062|  function _closePinDialog() {
1063|    var overlay = document.getElementById('st-pin-overlay');
1064|    if (overlay) overlay.remove();
1065|    ui.pinDialogOpen = false;
1066|    ui.pinError = '';
1067|  }
1068|
1069|  function _savePin() {
1070|    var auth = global.AlignAuth;
1071|    var user = auth ? auth.getActiveUser() : null;
1072|    if (!user) return;
1073|
1074|    var curEl     = document.getElementById('st-pin-current');
1075|    var newEl     = document.getElementById('st-pin-new');
1076|    var confirmEl = document.getElementById('st-pin-confirm');
1077|    var errEl     = document.getElementById('st-pin-error');
1078|
1079|    var currentPin = (curEl ? curEl.value.trim() : '');
1080|    var newPin     = (newEl ? newEl.value.trim() : '');
1081|    var confirmPin = (confirmEl ? confirmEl.value.trim() : '');
1082|
1083|    // Validate
1084|    if (!currentPin || !newPin) {
1085|      _showPinError('Enter current and new password.');
1086|      return;
1087|    }
1088|    if (newPin.length < 8) {
1089|      _showPinError('New password must be at least 8 characters.');
1090|      return;
1091|    }
1092|    if (newPin !== confirmPin) {
1093|      _showPinError('Passwords do not match.');
1094|      return;
1095|    }
1096|
1097|    // Save
1098|    try {
1099|      auth.updateUser(user.id, { password: newPin });
1100|      _closePinDialog();
1101|      // Re-render to reflect any change
1102|      _paint();
1103|      _wire();
1104|    } catch (e) {
1105|      _showPinError(e.message);
1106|    }
1107|  }
1108|
1109|  function _showPinError(msg) {
1110|    var errEl = document.getElementById('st-pin-error');
1111|    if (errEl) {
1112|      errEl.textContent = msg;
1113|      errEl.style.display = 'block';
1114|    }
1115|  }
1116|
1117|  /* ── Export Data ────────────────────────────────────────────────────────── */
1118|  function _exportData() {
1119|    var storage = S();
1120|    if (!storage) {
1121|      alert('Storage is not available.');
1122|      return;
1123|    }
1124|
1125|    var active = storage.getActiveProject();
1126|    if (!active) {
1127|      alert('No active project selected. Please select a project first.');
1128|      return;
1129|    }
1130|
1131|    // Gather all categories from storage
1132|    var categories = storage.categories || [
1133|      'drawings', 'daily-logs', 'specs', 'rfis',
1134|      'punchlist', 'schedule', 'budget', 'contacts',
1135|      'photos', 'tasks', 'procurement', 'files', 'settings'
1136|    ];
1137|
1138|    var exportData = {
1139|      project: {
1140|        id: active.id,
1141|        name: active.name,
1142|        address: active.address || '',
1143|        createdAt: active.createdAt,
1144|        exportedAt: new Date().toISOString()
1145|      },
1146|      records: {}
1147|    };
1148|
1149|    categories.forEach(function (cat) {
1150|      try {
1151|        var records = storage.listRecords(active.id, cat);
1152|        if (records && records.length) {
1153|          exportData.records[cat] = records;
1154|        }
1155|      } catch (e) {
1156|        // Category may not exist — skip
1157|      }
1158|    });
1159|
1160|    var json = JSON.stringify(exportData, null, 2);
1161|    var blob = new Blob([json], { type: 'application/json' });
1162|    var url  = URL.createObjectURL(blob);
1163|
1164|    var a = document.createElement('a');
1165|    a.href = url;
1166|    // Sanitize filename
1167|    var safeName = (active.name || 'project').replace(/[^a-zA-Z0-9_-]/g, '_');
1168|    a.download = 'align-export-' + safeName + '-' + new Date().toISOString().slice(0, 10) + '.json';
1169|    document.body.appendChild(a);
1170|    a.click();
1171|    document.body.removeChild(a);
1172|    URL.revokeObjectURL(url);
1173|  }
1174|
1175|  /* ── Clear Project Data ─────────────────────────────────────────────────── */
1176|  function _clearData() {
1177|    var storage = S();
1178|    if (!storage) {
1179|      alert('Storage is not available.');
1180|      return;
1181|    }
1182|
1183|    var active = storage.getActiveProject();
1184|    if (!active) {
1185|      alert('No active project selected.');
1186|      return;
1187|    }
1188|
1189|    if (!confirm(
1190|      '⚠️  This will permanently delete ALL records for "' + active.name + '".\n\n' +
1191|      'This includes drawings, daily logs, RFIs, punchlist, schedule, budget,\n' +
1192|      'contacts, photos, tasks, procurement, files, and specs.\n\n' +
1193|      'The project itself will be kept. This action cannot be undone.\n\n' +
1194|      'Are you sure?'
1195|    )) {
1196|      return;
1197|    }
1198|
1199|    if (!confirm('Final confirmation: Delete all data for "' + active.name + '"?')) {
1200|      return;
1201|    }
1202|
1203|    var categories = storage.categories || [
1204|      'drawings', 'daily-logs', 'specs', 'rfis',
1205|      'punchlist', 'schedule', 'budget', 'contacts',
1206|      'photos', 'tasks', 'procurement', 'files', 'settings'
1207|    ];
1208|
1209|    categories.forEach(function (cat) {
1210|      try {
1211|        storage.clearCategory(active.id, cat);
1212|      } catch (e) {
1213|        // Skip — category may not have a clear method or may not exist
1214|      }
1215|    });
1216|
1217|    alert('All data for "' + active.name + '" has been cleared.');
1218|  }
1219|
1220|  /* ════════════════════════════════════════════════════════════════════════════
1221|   * INIT — apply saved theme on load
1222|   * ════════════════════════════════════════════════════════════════════════════ */
1223|
1224|  // Apply theme immediately on script load
1225|  applyTheme(getTheme());
1226|
1227|  // Apply tile size immediately on script load
1228|  try {
1229|    var savedTileSize = getTileSize();
1230|    if (savedTileSize && savedTileSize !== 'default') {
1231|      var grid = document.querySelector('.tile-grid');
1232|      if (grid) {
1233|        if (savedTileSize === 'compact') grid.classList.add('tile-grid--compact');
1234|        else if (savedTileSize === 'large') grid.classList.add('tile-grid--large');
1235|      }
1236|    }
1237|  } catch (e) { /* silent */ }
1238|
1239|  // Re-apply theme when system preference changes (if set to 'system')
1240|  try {
1241|    var darkQuery = global.matchMedia('(prefers-color-scheme: dark)');
1242|    if (darkQuery && darkQuery.addEventListener) {
1243|      darkQuery.addEventListener('change', function () {
1244|        if (getTheme() === 'system') applyTheme('system');
1245|      });
1246|    }
1247|  } catch (e) { /* silent */ }
1248|
1249|  /* ── Public API ───────────────────────────────────────────────── */
1250|  window.AlignSettings = {
1251|    render: render
1252|  };
1253|
1254|})(window);